{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rahp/schema/rahp-result.schema.json",
  "title": "RAHP normalized assessment result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "assessment",
    "target",
    "mode",
    "status",
    "findings",
    "disposition",
    "evidence"
  ],
  "properties": {
    "version": {"const": 1},
    "assessment": {"type":"object","additionalProperties":false,"required":["id","key"],"properties":{"id":{"type":"string","minLength":1},"key":{"type":"string","minLength":1},"triggers":{"type":"array","items":{"type":"string"},"uniqueItems":true}}},
    "target": {"type":"object","additionalProperties":false,"required":["repository","reviewed_revision"],"properties":{"repository":{"type":"string","minLength":1},"reviewed_revision":{"type":"string","minLength":1},"baseline_revision":{"type":["string","null"]},"document":{"type":"string"}}},
    "mode": {"enum":["rahp","security","combined"]},
    "status": {"enum":["in-progress","completed","dispositioned"]},
    "findings": {"type":"array","items":{"type":"object","additionalProperties":true,"required":["id","title","status"],"properties":{"id":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"status":{"type":"string","minLength":1}}}},
    "disposition": {"type":"object","additionalProperties":false,"required":["outcome"],"properties":{"outcome":{"enum":["pending","no-material-assurance-impact","findings-raised","remediation-requested","risk-accepted","superseded"]},"summary":{"type":"string"},"decided_at":{"type":["string","null"]}}},
    "evidence": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","class","description"],"properties":{"id":{"type":"string","minLength":1},"class":{"enum":["ephemeral","referenced","durable","exemplar"]},"description":{"type":"string","minLength":1},"uri":{"type":"string"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"collected_at":{"type":"string"},"sensitivity":{"type":"string"}}}},
    "retest_triggers": {"type":"array","items":{"type":"string"}},
    "closure": {"type":"object","additionalProperties":false,"required":["eligible_issues","reviewed_revision"],"properties":{"eligible_issues":{"type":"array","items":{"type":"integer","minimum":1},"uniqueItems":true},"reviewed_revision":{"type":"string","minLength":1}}},
    "assurance_summary": {"type":"object","additionalProperties":false,"properties":{"assured":{"type":"integer","minimum":0},"controlled":{"type":"integer","minimum":0},"finding":{"type":"integer","minimum":0},"assurance-gap":{"type":"integer","minimum":0},"review-required":{"type":"integer","minimum":0},"not-assessed":{"type":"integer","minimum":0},"not-applicable":{"type":"integer","minimum":0}}},
    "evaluations": {"type":"array","items":{"type":"object","required":["proposition","signals","control_evidence","assurance_evidence","residual"]}},
    "remediations": {"type":"array","items":{"type":"object","required":["version","assessment_id","finding_id","owner_plane","requested_outcomes","required_evidence","publication"]}},
    "retests": {"type":"array","items":{"type":"object","required":["version","assessment_id","previous_finding","previous_revision","retested_revision","outcome","closure_evidence"]}}
  }
}
