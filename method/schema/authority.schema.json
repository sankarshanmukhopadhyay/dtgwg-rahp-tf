{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rahp/schema/authority.schema.json",
  "title": "RAHP portable authority grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "authority_id", "issuer", "subject", "grants", "status"],
  "properties": {
    "version": {"const": 1},
    "authority_id": {"type": "string", "minLength": 1},
    "issuer": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "suspended", "revoked", "expired"]},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "supersedes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "grants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "scope"],
        "properties": {
          "action": {"enum": ["observe", "assess", "disposition", "remediate", "publish", "accept-risk", "close", "reopen"]},
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id"],
            "properties": {
              "kind": {"enum": ["global", "target", "assessment", "finding", "remediation", "profile", "portfolio", "other"]},
              "id": {"type": "string", "minLength": 1}
            }
          },
          "constraints": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "locator"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
