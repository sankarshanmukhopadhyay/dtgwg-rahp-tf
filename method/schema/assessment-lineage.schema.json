{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rahp.dev/schema/assessment-lineage.schema.json",
  "title": "RAHP Assessment Lineage",
  "description": "Portable identity and run-lineage contract for an assurance assessment. The contract is deliberately independent of any deployment, repository host, specification family, or issue tracker.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment_id", "subject", "runs"],
  "properties": {
    "schema_version": {"const": 1},
    "assessment_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {
          "enum": ["specification", "repository", "implementation", "service", "deployment", "composition", "process", "dataset", "other"]
        },
        "name": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/run"}
    },
    "current_run_id": {"type": "string", "minLength": 1},
    "work_items": {
      "type": "array",
      "items": {"$ref": "#/$defs/workItem"},
      "uniqueItems": true
    }
  },
  "$defs": {
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1}
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["initial", "manual", "scheduled", "source-change", "evidence-change", "remediation", "policy-change", "composition-change", "other"]
        },
        "description": {"type": "string"},
        "revision": {"$ref": "#/$defs/revision"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "observed_at", "trigger", "status"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "predecessor_run_id": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "trigger": {"$ref": "#/$defs/trigger"},
        "target_revision": {"$ref": "#/$defs/revision"},
        "status": {
          "enum": ["planned", "in-progress", "complete", "superseded", "invalidated"]
        },
        "evidence_grade": {"type": "string", "minLength": 1},
        "result_uri": {"type": "string", "minLength": 1}
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "identifier", "relationship"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "identifier": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "relationship": {
          "enum": ["tracks", "reviews", "remediates", "retests", "publishes"]
        },
        "run_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
