{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.org/rahp/schema/remediation-manifest.schema.json",
  "title":"RAHP remediation manifest",
  "type":"object",
  "additionalProperties":false,
  "required":["version","assessment_id","finding_id","owner_plane","requested_outcomes","required_evidence","publication"],
  "properties":{
    "version":{"const":1},
    "remediation_id":{"type":"string","minLength":1},
    "assessment_id":{"type":"string","minLength":1},
    "assessment_run_id":{"type":"string","minLength":1},
    "finding_id":{"type":"string","minLength":1},
    "finding_run_id":{"type":"string","minLength":1},
    "status":{"enum":["proposed","accepted","in-progress","retest-required","completed","withdrawn","superseded"]},
    "owner_plane":{"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"enum":["target-repository","companion-specification","governance","implementation-guidance","runtime-control","operational-policy","external-governance","other"]},"repository":{"type":"string"},"authority":{"type":"string"},"uri":{"type":"string"}}},
    "requested_outcomes":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "acceptance_criteria":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","proposition"],"properties":{"id":{"type":"string","minLength":1},"proposition":{"type":"string","minLength":1},"evidence_required":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}}}},
    "required_evidence":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "retest_triggers":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"enum":["target-change","evidence-change","control-change","manual","scheduled","other"]},"subject":{"type":"string"},"description":{"type":"string"}}}},
    "authority":{"type":"object","additionalProperties":false,"properties":{"propose":{"type":"array","items":{"type":"string"},"uniqueItems":true},"approve":{"type":"array","items":{"type":"string"},"uniqueItems":true},"implement":{"type":"array","items":{"type":"string"},"uniqueItems":true},"accept_risk":{"type":"array","items":{"type":"string"},"uniqueItems":true},"close":{"type":"array","items":{"type":"string"},"uniqueItems":true}}},
    "publication":{"type":"object","additionalProperties":false,"required":["eligibility","mode","status"],"properties":{"eligibility":{"enum":["eligible","ineligible","needs-triage"]},"mode":{"enum":["governed","manual","none"]},"status":{"enum":["awaiting-approval","approved","published","not-required","rejected"]},"uri":{"type":"string"}}}
  }
}
