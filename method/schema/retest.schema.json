{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.org/rahp/schema/retest.schema.json",
  "title":"RAHP retest record","type":"object","additionalProperties":false,
  "required":["version","assessment_id","previous_finding","previous_revision","retested_revision","outcome","closure_evidence"],
  "properties":{
    "version":{"const":1},"assessment_id":{"type":"string","minLength":1},"previous_finding":{"type":"string","minLength":1},"previous_revision":{"type":"string","minLength":1},"retested_revision":{"type":"string","minLength":1},
    "outcome":{"enum":["resolved","residual","regression","inconclusive"]},
    "closure_evidence":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","result"],"properties":{"id":{"type":"string","minLength":1},"result":{"enum":["pass","fail","partial","not-produced"]},"uri":{"type":"string"}}}}
  }
}
