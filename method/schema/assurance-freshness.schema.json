{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rahp/schema/assurance-freshness.schema.json",
  "title": "RAHP assurance freshness record",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "assessment_id", "assessment_run_id", "status", "evaluated_at", "basis"],
  "properties": {
    "version": {"const": 1},
    "assessment_id": {"type": "string", "minLength": 1},
    "assessment_run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["current", "potentially-stale", "stale", "retest-required", "superseded", "indeterminate"]},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "basis": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "effect"], "properties": {
      "kind": {"enum": ["target-change", "evidence-change", "control-change", "dependency-change", "expiry", "supersession", "manual-review", "unknown"]},
      "id": {"type": "string", "minLength": 1},
      "effect": {"enum": ["none", "potential", "invalidating", "requires-retest", "supersedes", "unknown"]},
      "reason": {"type": "string"}
    }}},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "retest_required": {"type": "boolean"},
    "superseded_by_run_id": {"type": "string"}
  }
}
