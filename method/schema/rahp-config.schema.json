{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rahp/schema/rahp-config.schema.json",
  "title": "RAHP configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "profile",
    "repositories"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_mode": {
          "enum": [
            "rahp",
            "security",
            "combined"
          ]
        },
        "rahp_repository": {
          "type": "string",
          "minLength": 1
        },
        "rahp_version": {
          "type": "string",
          "minLength": 1
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workspace_directory": {
              "type": "string",
              "default": ".rahp"
            },
            "ephemeral_days": {
              "type": "integer",
              "minimum": 1,
              "default": 14
            },
            "referenced_days": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "default": 365
            },
            "external_evidence_base_uri": {
              "type": "string"
            },
            "allow_sensitive_git_evidence": {
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "branch": {
            "type": "string",
            "default": "main"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "upstream": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "document": {
            "type": "string"
          },
          "context": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "title": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              }
            }
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "include": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "reviews": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "rahp",
                "security",
                "combined"
              ]
            }
          },
          "local_path": {
            "type": "string"
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": {
          "type": "string"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "namespace": {
          "type": "string"
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
