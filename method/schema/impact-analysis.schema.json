{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rahp/schema/impact-analysis.schema.json",
  "title": "RAHP impact analysis result",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "graph_id", "changed_nodes", "affected_nodes", "affected_assessments", "retest_required"],
  "properties": {
    "version": {"const": 1},
    "graph_id": {"type": "string", "minLength": 1},
    "changed_nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "affected_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "distance", "via"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "distance": {"type": "integer", "minimum": 0},
          "via": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "affected_assessments": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "retest_required": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unresolved_changed_nodes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
