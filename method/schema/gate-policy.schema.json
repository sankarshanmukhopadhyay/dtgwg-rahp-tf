{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rahp/schema/gate-policy.schema.json",
  "title": "RAHP portable policy gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "policy_id", "purpose", "rules"],
  "properties": {
    "version": {"const": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "effect", "conditions"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "effect": {"enum": ["deny", "require"]},
          "message": {"type": "string"},
          "conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "operator"],
              "properties": {
                "path": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
                "operator": {"enum": ["equals", "not-equals", "in", "not-in", "exists", "not-exists"]},
                "value": {}
              }
            }
          }
        }
      }
    },
    "authority_required": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "scope"],
      "properties": {
        "action": {"enum": ["observe", "assess", "disposition", "remediate", "publish", "accept-risk", "close", "reopen"]},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": {"enum": ["global", "target", "assessment", "finding", "remediation", "profile", "portfolio", "other"]},
            "id": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
