{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/method/schema/delegation-scope.schema.json",
  "title": "RAHP delegation scope constraint",
  "description": "Portable v0.4 schema for expressing bounded delegated authority without treating liveness, identity, or key control as authority.",
  "type": "object",
  "required": [
    "version",
    "delegation_id",
    "principal",
    "delegate",
    "actor_class",
    "capabilities",
    "validity",
    "revocation"
  ],
  "properties": {
    "version": {
      "const": "0.4"
    },
    "delegation_id": {
      "type": "string",
      "minLength": 3
    },
    "principal": {
      "type": "string",
      "minLength": 3
    },
    "delegate": {
      "type": "string",
      "minLength": 3
    },
    "actor_class": {
      "enum": [
        "NHA-AUTONOMOUS",
        "NHA-SUPERVISED",
        "NHA-PIPELINE"
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resource_scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "constraints": {
      "type": "object",
      "properties": {
        "human_confirmation_required": {
          "type": "boolean"
        },
        "max_transaction_value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "jurisdictions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "max_delegation_depth": {
          "type": "integer",
          "minimum": 0
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "validity": {
      "type": "object",
      "required": [
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "revocation": {
      "type": "object",
      "required": [
        "mechanism"
      ],
      "properties": {
        "mechanism": {
          "type": "string",
          "minLength": 3
        },
        "status_endpoint": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "notification_sla_hours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "liveness": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "maximum_age_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "evidence_type": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "required"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "issuer": {
          "type": [
            "string",
            "null"
          ]
        },
        "issued_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_credential": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
