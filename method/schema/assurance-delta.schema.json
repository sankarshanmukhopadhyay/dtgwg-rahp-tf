{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rahp/schema/assurance-delta.schema.json",
  "title": "RAHP assurance delta",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "assessment_id", "baseline_run_id", "current_run_id", "material_change", "findings", "controls", "evidence", "conclusion"],
  "properties": {
    "version": {"const": 1},
    "assessment_id": {"type": "string", "minLength": 1},
    "baseline_run_id": {"type": "string", "minLength": 1},
    "current_run_id": {"type": "string", "minLength": 1},
    "material_change": {"type": "boolean"},
    "findings": {"$ref": "#/$defs/changeSet"},
    "controls": {"$ref": "#/$defs/changeSet"},
    "evidence": {"$ref": "#/$defs/changeSet"},
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous", "current", "transition"],
      "properties": {
        "previous": {"enum": ["assured", "controlled", "finding", "assurance-gap", "review-required", "not-assessed", "not-applicable"]},
        "current": {"enum": ["assured", "controlled", "finding", "assurance-gap", "review-required", "not-assessed", "not-applicable"]},
        "transition": {"enum": ["unchanged", "improved", "degraded", "resolved", "regressed", "indeterminate"]}
      }
    },
    "freshness": {"enum": ["current", "potentially-stale", "stale", "retest-required", "superseded", "indeterminate"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "changeSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["introduced", "resolved", "changed", "unchanged"],
      "properties": {
        "introduced": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "resolved": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "changed": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "unchanged": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
