{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rahp/schema/evidence-manifest.schema.json",
  "title": "RAHP evidence provenance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "evidence_id", "evidence_type", "source", "producer", "observed_at", "integrity", "authority", "supports"],
  "properties": {
    "version": {"const": 1},
    "evidence_id": {"type": "string", "minLength": 1},
    "evidence_type": {"enum": ["normative-text", "implementation-artifact", "test-result", "deployment-observation", "governance-record", "operational-record", "build-artifact", "documentation", "dataset", "attestation", "other"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "revision"],
      "properties": {
        "kind": {"enum": ["repository", "document", "service", "dataset", "registry", "runtime", "process", "other"]},
        "locator": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "path": {"type": "string"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism"],
      "properties": {
        "mechanism": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "workflow": {"type": "string"},
        "actor": {"type": "string"}
      }
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "retest_on_source_change": {"type": "boolean"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"enum": ["sha256", "sha384", "sha512", "other"]},
        "digest": {"type": "string", "minLength": 1}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "class": {"enum": ["normative", "authoritative", "supporting", "informative", "incidental"]},
        "issuer": {"type": "string"},
        "basis": {"type": "string"}
      }
    },
    "supports": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "applicable_patterns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
