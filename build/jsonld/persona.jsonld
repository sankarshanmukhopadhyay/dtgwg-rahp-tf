    {
      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/EC2a",
      "@type": "Persona",
      "name": "Arthur Kowalczyk",
      "role": "Person Living with Dementia — credential holder with progressive capacity loss",
      "type": "edge_case",
      "co_persona": "EC2b",
      "quote": "I want to stay part of this community. I just need to know that if I can't manage it myself one day, Margaret can do it for me — and that it will still be my identity, not hers.",
      "context": {
        "age": 74,
        "location": "Sheffield, UK",
        "diagnosis": "Early-stage vascular dementia; capacity intermittent and progressive",
        "capacity_status": "Currently has capacity; LPA registered but not yet primary decision-making instrument"
      },
      "lifecycle_phases": [
        "Ongoing",
        "Revocation",
        "Expiration"
      ],
      "goals": [
        "Remain an active, recognised VTC member for as long as he has capacity",
        "Ensure his attorney can take over credential management seamlessly on capacity loss",
        "Retain the sense that his trust graph identity is his own, not a proxy created for his carer",
        "Not have his diagnosis disclosed or embedded in credential metadata without explicit consent"
      ],
      "risk_context": [
        "Credential architecture has no concept of progressive, variable capacity to consent",
        "LPA translation gap — a registered Lasting Power of Attorney has no DTG credential equivalent",
        "Continuity of identity through a capacity transition is unspecified",
        "GR-08 revocation due process assumes the member can receive and respond to notice",
        "Intermittent capacity is a higher-value social engineering target for B1 and M2"
      ],
      "inclusion_drivers": [
        "LPA-equivalent delegation credential",
        "Capacity-sensitive revocation due process routed to the attorney",
        "Identity continuity on delegation — M-DID persists through transition"
      ],
      "exclusion_risks": [
        "Progressive capacity loss makes trust task ceremonies unusable",
        "A VTC that cannot model guardianship defaults to treating him as full-capacity until a crisis"
      ],
      "evidence": [
        {
          "claim": "Around 982,000 people are living with dementia in the UK, with over a third lacking a formal diagnosis. The Mental Capacity Act 2005 requires capacity to be assessed decision-by-decision.",
          "source": "Alzheimer's Society, Dementia Action Week 2025",
          "url": "https://www.alzheimers.org.uk/"
        },
        {
          "claim": "An LPA can only be created while the person still has capacity; once lost, the costlier Court of Protection deputyship route is required.",
          "source": "Dementia UK, Lasting Power of Attorney, 2025",
          "url": "https://www.dementiauk.org/information-and-support/financial-and-legal-support/lasting-power-of-attorney/"
        }
      ]
    },
    {
      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/EC2b",
      "@type": "Persona",
      "name": "Margaret Kowalczyk",
      "role": "Partner, Carer and registered LPA holder",
      "type": "edge_case",
      "co_persona": "EC2a",
      "quote": "The law says I can make decisions for Arthur when he can't. But the system doesn't know I exist. It just sees his DID going quiet.",
      "context": {
        "age": 72,
        "location": "Sheffield, UK",
        "dtg_role": "Delegated credential operator for EC2a's M-DID; not an independent VTC member",
        "legal_basis": "Registered Health and Welfare LPA and Property and Financial Affairs LPA"
      },
      "lifecycle_phases": [
        "Ongoing",
        "Revocation"
      ],
      "goals": [
        "Exercise LPA authority over credentials in a legally sound, auditable and reversible way",
        "Preserve the donor's VTC membership and trust graph relationships through capacity transitions",
        "Receive governance communications, including revocation notices, on the donor's behalf",
        "Avoid personal liability for operations performed in good faith as attorney"
      ],
      "risk_context": [
        "No legal recognition of the LPA in the DTG architecture",
        "Authentication challenge — the VTA cannot distinguish a legitimate LPA holder from account takeover",
        "Notification gap — no support for secondary notification recipients",
        "Liability without framework — no audit trail to demonstrate Mental Capacity Act compliance",
        "Credential scope creep — an over-broad delegation could forge the donor's trust relationships"
      ],
      "inclusion_drivers": [
        "LPA-equivalent delegation credential registered in the trust registry, scope-limited and separately audited",
        "Secondary notification registration for credential lifecycle communications",
        "Clear revocation pathway restoring sole control if capacity returns"
      ],
      "exclusion_risks": [
        "Without a formal delegation model she is invisible to the system and cannot be involved in due process",
        "No defined pathway to close the donor's M-DID on death or preserve membership history"
      ],
      "evidence": [
        {
          "claim": "The Mental Capacity Act 2005 requires attorneys to act in the donor's best interests and keep clear records; the NHS requires hospitals to be informed of LPA status as early as possible.",
          "source": "NHS, Managing Legal Affairs After a Dementia Diagnosis",
          "url": "https://www.nhs.uk/conditions/dementia/care-and-support/legal-issues/"
        }
      ]
    },
    {
      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/EC3",
      "@type": "Persona",
      "name": "Northgate Community Health Trust",
      "role": "Public sector healthcare provider — organisational member",
      "type": "edge_case",
      "organisational": true,
      "quote": "We are not a person. We are a regulated organisation with a board, a Caldicott Guardian, and a statutory duty of care. Our credential needs to carry the weight of that accountability.",
      "context": {
        "entity_type": "NHS Foundation Trust (fictitious); CQC registered",
        "jurisdiction": "England — NHS England regulatory framework",
        "dtg_role": "Organisational VTC member holding a C-DID; issuing authority for staff M-DIDs and VMCs",
        "accountable_officers": [
          "Caldicott Guardian",
          "Data Protection Officer",
          "Chief Digital Officer"
        ],
        "regulatory_context": "NHS DCB3051 Identity Verification and Authentication Standard (updated December 2024 to align with GPG45); UK GDPR; NHS Care Identity Service 2 (CIS2)"
      },
      "lifecycle_phases": [
        "Phase 2",
        "Phase 3",
        "Phase 4",
        "Revocation"
      ],
      "goals": [
        "Issue verifiable staff credentials interoperable across NHS Trusts and recognised by CIS2",
        "Participate as a trusted institutional member so staff avoid paper-based verification",
        "Maintain compliance with the NHS identity standard and the Data Security and Protection Toolkit",
        "Revoke a leaver's VMC promptly with revocation visible to NHS relying parties"
      ],
      "risk_context": [
        "Organisational identity is not a natural person — the C-DID model assumes capacity to consent",
        "Trust anchor accountability sits personally with the Caldicott Guardian and CDO",
        "Revocation at scale — the NHS Digital Staff Passport requires near-real-time revocation",
        "Multi-jurisdictional staff working across Trust boundaries with differing implementations",
        "Data residency — NHS patient-adjacent data cannot leave UK jurisdiction"
      ],
      "inclusion_drivers": [
        "Interoperability with NHS CIS2",
        "Governance conformance class satisfied by existing statutory governance, properly documented",
        "Caldicott Guardian as trust anchor — a coherent mapping of an existing NHS data governance role"
      ],
      "exclusion_risks": [
        "The DTG specification does not define an organisational credential type",
        "NHS procurement and information governance cycles (12–18 months) are incompatible with DTG cadence"
      ],
      "evidence": [
        {
          "claim": "The NHS Digital Staff Passport enabled rapid staff redeployment across 100 NHS Trusts using verifiable credentials, moving to public beta in 2025. Lessons — wallet-agnosticism is essential; issuance must connect to existing HR systems; multi-organisational trust governance is complex.",
          "source": "techUK / NHSx-Condatis case study",
          "url": "https://www.techuk.org/resource/healthcare-decentralised-identity-case-study-nhsx.html"
        },
        {
          "claim": "NHS organisations are subject to DCB3051 and CIS2; the DTG trust registry concept maps onto the NHS Credentials Gateway but the integration is unspecified.",
          "source": "NHS Standards Directory, Identity Verification and Authentication Standard",
          "url": "https://standards.nhs.uk/published-standards/identity-verification-and-authentication-standard-for-digital-health-and-care-services"
        }
      ]
    },
    {
      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/EC4",
      "@type": "Persona",
      "name": "Velvet Gate Ltd",
      "role": "Age-restricted content service provider — relying party",
      "type": "edge_case",
      "organisational": true,
      "safeguarding": true,
      "safeguarding_note": "Included because this sector drives the UK's Online Safety Act 2023 age verification requirements, making it the most demanding real-world test of the DTG identity verification architecture. Presented analytically. All design decisions for this persona must prioritise child safety and comply with the Online Safety Act 2023 and Ofcom age assurance guidance effective 25 July 2025.",
      "quote": "We have a legal obligation to verify that every subscriber is over 18. We have a competing legal obligation not to build a surveillance database of who watches what.",
      "context": {
        "entity_type": "UK-registered SME; Part 5 service under the Online Safety Act 2023 (fictitious)",
        "jurisdiction": "UK-registered, serving UK and international subscribers; regulated by Ofcom",
        "dtg_role": "Relying party — does not issue VMCs, relies on age-verified IDVCs from approved IDVPs",
        "regulatory_context": "Online Safety Act 2023 Part 5; mandatory age assurance from 25 July 2025; UK GDPR; Ofcom Children's Code"
      },
      "lifecycle_phases": [
        "Phase 4",
        "Ongoing"
      ],
      "goals": [
        "Satisfy Ofcom's highly effective age assurance requirement without a persistent identity database",
        "Use ZKP-based proof of being over 18 to comply with the Online Safety Act and UK GDPR simultaneously",
        "Achieve compliance that is technically auditable by Ofcom",
        "Reduce exposure to fines of up to £18m or 10% of global qualifying revenue"
      ],
      "risk_context": [
        "Surveillance vs compliance paradox — robust age verification versus data minimisation",
        "IDVP quality risk — IDVP failure cascades onto the relying party (see AU10TIX, 2024)",
        "Bad actor abuse — automated fake-age-credential generation at scale by B1 and M2",
        "Child safety is non-negotiable — an architecture gap allowing a minor to obtain a valid over-18 IDVC is a criminal liability, not merely a governance risk",
        "Cross-border enforcement — non-UK IDVP standing in the trust registry is uncertain"
      ],
      "inclusion_drivers": [
        "ZKP-based age proofs satisfying both Ofcom age assurance and UK GDPR data minimisation",
        "Well-governed IDVP approval process giving a defensible basis for third-party reliance",
        "Ofcom's accepted methods include digital ID services, encompassing W3C VC-based approaches"
      ],
      "exclusion_risks": [
        "If ZKP implementation remains future work (as in spec v0.3), it cannot be relied on for compliance",
        "Reputational risk may make some IDVPs and anchors unwilling to participate"
      ],
      "evidence": [
        {
          "claim": "From 25 July 2025 Ofcom enforces highly effective age assurance with fines up to £18m or 10% of global qualifying revenue; accepted methods include digital ID services but must be technically accurate, robust, reliable and fair.",
          "source": "Ofcom, Age Checks for Online Safety, June 2025",
          "url": "https://www.ofcom.org.uk/online-safety/protecting-children/age-checks-for-online-safety--what-you-need-to-know-as-a-user"
        },
        {
          "claim": "The AU10TIX breach illustrates what happens when age verification relies on centralised IDVP databases rather than holder-controlled zero-knowledge proofs.",
          "source": "Lawfare, To Read This Please Upload Photo ID, 2026",
          "url": "https://www.lawfaremedia.org/article/to-read-this--please-upload-photo-id"
        }
      ]
    },
    {
      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/P1",
      "@type": "Persona",
      "name": "Principal / Rights-Bearing Party",
      "role": "Principal, rights holder, represented person, or consent-giving party",
      "type": "portable_role",
      "quote": "An action may involve me, my rights, my assets, or my authority even when another system performs it.",
      "context": {
        "operating_context": "A person or organization whose rights, interests, assets, consent, or delegated authority can be affected by actions taken directly or through intermediaries and automated systems.",
        "authority_position": "May grant, withhold, narrow, amend, or withdraw authority where the governing framework permits, but may not control every technical system that acts on that authority.",
        "dependencies": "Depends on producers, relying parties, intermediaries, delegated services, and trust infrastructure to preserve the meaning and lifecycle of authority."
      },
      "lifecycle_phases": [
        "Establishment / enrolment",
        "Grant or consent",
        "Use / presentation / execution",
        "Amendment / revocation / dispute"
      ],
      "goals": [
        "Ensure actions affecting rights or interests remain within granted authority",
        "Understand who is acting, for whom, for what purpose, and on what basis",
        "Withdraw, amend, contest, or constrain authority where applicable",
        "Obtain meaningful notice, explanation, and redress when consequential decisions are made"
      ],
      "risk_context": [
        "Authority can be inferred from identity or possession rather than an explicit grant",
        "Consent or delegation can outlive its intended purpose, scope, or validity",
        "Multi-party rights may be collapsed into a single actor’s decision",
        "Intermediaries or agents can obscure who initiated or approved a consequential action",
        "Technical success may provide no usable route to explanation, correction, or redress"
      ],
      "power_and_decisions": [
        "Can grant or refuse consent or delegation where the applicable governance permits",
        "Can define purpose or scope boundaries for represented action",
        "Can challenge, amend, or revoke authority, subject to system and governance support"
      ],
      "harms_and_externalities": [
        "Loss of autonomy when another actor acts beyond granted purpose or scope",
        "Financial, reputational, privacy, safety, or access harms caused by incorrect or stale authority",
        "Reduced ability to obtain redress when intermediaries or automated actors obscure accountability"
      ],
      "inclusion_drivers": [
        "Explicit authority and consent boundaries",
        "Revocation and lifecycle semantics",
        "Accessible evidence of who acted for whom",
        "Usable notice, contestability, and redress mechanisms"
      ],
      "exclusion_risks": [
        "Rights-bearing parties can become invisible behind intermediaries, platforms, credentials, or agents",
        "People unable to use the preferred identity, device, language, accessibility, or consent mechanism may be unable to exercise equivalent control",
        "Multi-party or supported-decision contexts may be forced into a single-principal model"
      ],
      "pressure_test_situations": [
        "A valid credential is presented after the principal withdrew the underlying authority",
        "An agent completes an action that is technically permitted but outside the principal’s stated purpose",
        "Two people have legitimate but conflicting rights in the same asset, content, or transaction",
        "The principal contests an action but cannot determine which intermediary or delegated service made the effective decision"
      ],
      "evidence": [
        {
          "claim": "Digital identity and federation systems require privacy, lifecycle, assertion, and relying-party controls rather than treating successful authentication as unlimited authority.",
          "source": "NIST SP 800-63-4 Digital Identity Guidelines",
          "url": "https://csrc.nist.gov/pubs/sp/800/63/4/final"
        },
        {
          "claim": "Verifiable credential ecosystems distinguish issuer, holder, verifier, credential status, trust, privacy, and security concerns; verification does not by itself establish every business or governance conclusion.",
          "source": "W3C Verifiable Credentials Data Model v2.0",
          "url": "https://www.w3.org/TR/vc-data-model-2.0/"
        }
      ]
    },
    {
      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/P2",
      "@type": "Persona",
      "name": "Producer / Originating Actor",
      "role": "Actor that originates content, metadata, assertions, requests, or signed evidence",
      "type": "portable_role",
      "quote": "I can produce authentic evidence, but authenticity does not automatically make every statement authoritative for every purpose.",
      "context": {
        "operating_context": "An actor that originates content, metadata, assertions, requests, credentials, or other evidence that downstream systems may authenticate, transform, or rely upon.",
        "authority_position": "Controls creation of an output but may have authority for only some properties, subjects, purposes, or time periods represented by that output.",
        "dependencies": "Depends on schemas, signing/provenance mechanisms, lifecycle metadata, and downstream interpretation to preserve intended scope."
      },
      "lifecycle_phases": [
        "Origination / issuance",
        "Signing / attestation",
        "Distribution / transformation",
        "Update / withdrawal / supersession"
      ],
      "goals": [
        "Produce interoperable and accurately scoped evidence",
        "Avoid having assertions interpreted beyond their intended meaning",
        "Preserve provenance and accountability for outputs",
        "Make authority, subject, purpose, and lifecycle boundaries discoverable downstream"
      ],
      "risk_context": [
        "Signed or integrity-protected output can be over-read as truth or authority",
        "Optional evidence may be stripped, omitted, or transformed downstream",
        "The producer may lack authority over a represented subject, right, property, or purpose",
        "A formerly correct assertion may remain technically verifiable after circumstances change",
        "Ambiguous schemas or UI labels may cause downstream parties to infer stronger claims than the producer intended"
      ],
      "power_and_decisions": [
        "Chooses what evidence or assertions to originate",
        "Chooses what metadata, provenance, scope, and lifecycle information accompanies an output within the governing format",
        "May update, withdraw, or supersede evidence when supported by the system"
      ],
      "harms_and_externalities": [
        "Overbroad or ambiguous assertions can cause downstream denial, authorization, attribution, or reputational harm",
        "Missing provenance or lifecycle data can transfer uncertainty to relying parties and affected principals",
        "Incorrect claims about another person, organization, asset, or right can become durable because cryptographic authenticity protects the statement rather than its truth"
      ],
      "inclusion_drivers": [
        "Clear assertion semantics",
        "Property-specific authority rules",
        "Stable provenance and lifecycle metadata",
        "Mechanisms to correct, supersede, or withdraw evidence"
      ],
      "exclusion_risks": [
        "Producer identity can overshadow the rights or authority of other affected parties",
        "Small or non-standard producers may be rejected when ecosystems privilege a narrow set of issuers, signers, or tooling",
        "Mandatory metadata or assurance requirements may impose costs that exclude legitimate low-resource producers"
      ],
      "pressure_test_situations": [
        "A producer signs an assertion about a subject for which it has identity evidence but no domain authority",
        "An intermediary strips optional provenance before a relying party receives the object",
        "A claim was correct when issued but is stale when later relied upon",
        "Two authentic producers make conflicting assertions about the same property"
      ],
      "evidence": [
        {
          "claim": "Data Integrity proofs provide authenticity and integrity properties but applications still need explicit semantics, trust decisions, and privacy/security handling.",
          "source": "W3C Verifiable Credential Data Integrity 1.0",
          "url": "https://www.w3.org/TR/vc-data-integrity/"
        },
        {
          "claim": "Verifiable credential trust depends on ecosystem roles, business rules, status and contextual verification rather than signature validity alone.",
          "source": "W3C Verifiable Credentials Data Model v2.0",
          "url": "https://www.w3.org/TR/vc-data-model-2.0/"
        }
      ]
    },
    {
      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/P3",
      "@type": "Persona",
      "name": "Relying Party / Verifier",
      "role": "Actor that consumes evidence and makes a trust, policy, routing, authorization, or presentation decision",
      "type": "portable_role",
      "quote": "Validation tells me something important, but I still need to know what I am entitled to conclude from it.",
      "context": {
        "operating_context": "An actor or automated policy component that consumes evidence and converts it into a trust, routing, eligibility, authorization, moderation, or presentation decision.",
        "authority_position": "Controls the local decision policy and therefore determines what evidence counts, how failures are interpreted, and what consequence follows for affected parties.",
        "dependencies": "Depends on evidence producers, trust/status services, policy configuration, freshness, conflict handling, and usable presentation of verification results."
      },
      "lifecycle_phases": [
        "Evidence acquisition",
        "Verification / validation",
        "Policy decision",
        "Challenge / appeal / audit"
      ],
      "goals": [
        "Make defensible trust and authorization decisions",
        "Distinguish integrity, identity, authority, consent, and policy",
        "Detect missing, stale, conflicting, or downgraded evidence",
        "Explain and audit consequential decisions without treating technical validation as sufficient justification"
      ],
      "risk_context": [
        "Cryptographic validity can be mistaken for semantic trustworthiness or legal/business authority",
        "Failure or absence may silently downgrade decision quality or be treated as proof of ineligibility",
        "Different trust lanes can be treated as equivalent without policy",
        "Status or registry information may be stale, unavailable, or incapable of answering historical questions",
        "Automation may hide which evidence, threshold, or policy rule actually caused a denial or approval"
      ],
      "power_and_decisions": [
        "Defines or applies the acceptance policy for evidence",
        "Can approve, deny, route, rank, flag, or condition access based on verification outcomes",
        "Determines whether missing, conflicting, stale, or unfamiliar evidence causes failure, fallback, or escalation"
      ],
      "harms_and_externalities": [
        "False rejection can exclude legitimate parties from services, markets, speech, transactions, or redress",
        "False acceptance can expose principals and third parties to fraud, impersonation, unauthorized action, or unsafe content",
        "Overcollection and retention of verification evidence can introduce correlation, privacy, and surveillance harms"
      ],
      "inclusion_drivers": [
        "Explicit decision policy",
        "Freshness and status checks",
        "Negative and downgrade-path assurance tests",
        "Human-understandable failure, escalation, and appeal paths"
      ],
      "exclusion_risks": [
        "UI or protocol success signals can encourage overconfidence or unjustified exclusion",
        "Unfamiliar but valid trust mechanisms may be rejected because policy is coupled to a narrow ecosystem",
        "Absence of optional evidence may be treated as adverse evidence against legitimate edge cases"
      ],
      "pressure_test_situations": [
        "A credential validates cryptographically but the issuer’s relevant authority has expired",
        "The registry or status service cannot be reached at decision time",
        "Two authoritative evidence sources disagree",
        "A delegated agent presents valid evidence outside the principal’s delegated purpose or scope",
        "Optional higher-assurance evidence disappears through an intermediary before verification"
      ],
      "evidence": [
        {
          "claim": "Federation guidance requires relying parties to validate assertion restrictions, trust agreements and lifecycle conditions rather than equating a valid assertion with unrestricted acceptance.",
          "source": "NIST SP 800-63C-4 Federation and Assertions",
          "url": "https://csrc.nist.gov/pubs/sp/800/63/c/4/final"
        },
        {
          "claim": "Zero-trust architecture separates authentication from resource-specific authorization and applies least-privilege, continuously evaluated policy.",
          "source": "NIST SP 800-207 Zero Trust Architecture",
          "url": "https://csrc.nist.gov/pubs/sp/800/207/final"
        }
      ]
    },
    {
      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/P4",
      "@type": "Persona",
      "name": "Intermediary / Platform Operator",
      "role": "Platform, publisher, gateway, distributor, transformer, host, or callback service between originator and relying party",
      "type": "portable_role",
      "quote": "I move, transform, route, or present evidence. That makes my handling choices part of the trust boundary.",
      "context": {
        "operating_context": "A platform, publisher, gateway, distributor, transformer, host, wallet, broker, or callback service positioned between an originator and relying party.",
        "authority_position": "Controls transport, transformation, storage, ranking, presentation, or policy enforcement that can materially change what downstream parties observe and conclude.",
        "dependencies": "Depends on upstream evidence quality and downstream interpretation while also becoming a distinct security, privacy, availability, and governance boundary."
      },
      "lifecycle_phases": [
        "Ingestion",
        "Transformation / routing / storage",
        "Presentation / delivery",
        "Retention / deletion / incident response"
      ],
      "goals": [
        "Preserve relevant assurance information across processing",
        "Apply policy consistently at scale",
        "Avoid becoming a downgrade, correlation, substitution, or redirection point",
        "Make transformations and failure states observable enough for downstream accountability"
      ],
      "risk_context": [
        "Transformation can remove optional or higher-layer evidence",
        "Presentation can overstate verification meaning",
        "Callback, routing, resolution, or storage functions can introduce new security and privacy boundaries",
        "Retries, caching, or normalization can unintentionally make stale evidence appear current",
        "Platform policy can become de facto governance even when the underlying standard permits more diverse participation"
      ],
      "power_and_decisions": [
        "Can accept, reject, transform, suppress, enrich, cache, or route evidence",
        "Controls how assurance results and warnings are presented to users or downstream systems",
        "May impose participation, retention, moderation, ranking, or interoperability policies beyond the base protocol"
      ],
      "harms_and_externalities": [
        "Evidence stripping or transformation can cause downstream parties to make weaker decisions without knowing assurance was lost",
        "Centralized observation of transactions or verification events can enable correlation and surveillance",
        "Opaque platform policy can exclude legitimate participants or amplify particular producers, trust services, or technical implementations"
      ],
      "inclusion_drivers": [
        "Evidence-preserving transformation rules",
        "Clear failure-state behaviour",
        "Auditable policy enforcement",
        "Interoperable export, fallback, and migration paths where practical"
      ],
      "exclusion_risks": [
        "Centralized platforms can become participation gates or hidden policy authorities",
        "Proprietary transformations may disadvantage participants using otherwise conformant alternative implementations",
        "Accessibility, bandwidth, device, or account requirements introduced by the intermediary can exclude users the underlying protocol could support"
      ],
      "pressure_test_situations": [
        "A platform removes an optional assertion during media or message transformation",
        "A callback is redirected to an attacker-controlled endpoint while the original request remains valid",
        "Cached registry or credential-status information survives beyond its safe freshness window",
        "The platform presents a binary “verified” signal although only a subset of claims were actually checked"
      ],
      "evidence": [
        {
          "claim": "API ecosystems face broken authorization, unsafe consumption of third-party resources, inventory/version drift, and security misconfiguration at intermediary boundaries.",
          "source": "OWASP API Security Top 10 – 2023",
          "url": "https://owasp.org/API-Security/editions/2023/en/0x11-t10/"
        },
        {
          "claim": "Security and privacy controls treat audit, access control, integrity, resilience, and system protection as distinct responsibilities across information-system boundaries.",
          "source": "NIST SP 800-53 Rev. 5",
          "url": "https://csrc.nist.gov/pubs/sp/800/53/r5/final"
        }
      ]
    },
    {
      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/P5",
      "@type": "Persona",
      "name": "Delegated Service / Agent Operator",
      "role": "Operator of a service or agent acting on behalf of another party or consuming delegated authority",
      "type": "portable_role",
      "quote": "Being able to perform an action is not the same as being authorised to perform it for this principal, purpose, and scope.",
      "context": {
        "operating_context": "An organization, service, software agent, or agent operator that performs actions for another party or receives delegated authority to invoke tools, services, transactions, or downstream agents.",
        "authority_position": "Can exercise delegated capability but should not infer broader authority merely from credential possession, connectivity, technical capability, or prior approval.",
        "dependencies": "Depends on explicit principal, purpose, scope, expiry, approval, onward-delegation, and revocation semantics remaining intact across service boundaries."
      },
      "lifecycle_phases": [
        "Delegation grant",
        "Delegated execution",
        "Onward delegation / tool use",
        "Expiry / revocation / audit"
      ],
      "goals": [
        "Receive only the authority needed for the assigned task",
        "Preserve principal, purpose, scope, and approval boundaries",
        "Produce accountable evidence of consequential actions",
        "Stop or re-authorize activity when delegation, policy, or principal intent changes"
      ],
      "risk_context": [
        "Delegation context can be lost across service or agent hops",
        "Secondary credentials can become transitive authority",
        "A valid capability may be confused with permission to act",
        "Sub-agents or asynchronous jobs may survive revocation of the originating authorization",
        "Opaque execution can prevent a principal or relying party from reconstructing who decided and performed each consequential step"
      ],
      "power_and_decisions": [
        "Can invoke tools or services within the technical reach granted to it",
        "May select execution paths, downstream services, or sub-agents unless constrained",
        "May generate new requests, evidence, transactions, or side effects attributed to the principal"
      ],
      "harms_and_externalities": [
        "Scope creep can cause unauthorized purchases, disclosures, submissions, changes, or commitments",
        "Onward delegation can expose principal data and authority to parties the principal never evaluated",
        "Weak action provenance can leave principals, operators, and affected third parties unable to attribute or contest harmful actions"
      ],
      "inclusion_drivers": [
        "Bounded delegation",
        "Non-transitive credentials by default",
        "Cross-service action provenance",
        "Fast revocation and explicit re-authorization for consequential changes"
      ],
      "exclusion_risks": [
        "Opaque delegation chains can make redress and accountability difficult",
        "Systems that require continuous human intervention may exclude legitimate users who rely on assistive or autonomous delegation",
        "Overly broad prohibitions on delegated actors can deny equivalent access to people and organizations that cannot interact directly with every service"
      ],
      "pressure_test_situations": [
        "A sub-agent receives a credential that the original principal never authorized for onward delegation",
        "The principal revokes authority while an asynchronous action is queued",
        "An agent has technical access to a tool but the requested action exceeds the delegated purpose",
        "A downstream service cannot distinguish the agent operator’s authority from the principal’s authority"
      ],
      "evidence": [
        {
          "claim": "Agentic systems introduce excessive-agency, delegated-action, tool-use, and trust-boundary risks that require explicit mitigations.",
          "source": "OWASP Agentic AI – Threats and Mitigations",
          "url": "https://genai.owasp.org/resource/agentic-ai-threats-and-mitigations/"
        },
        {
          "claim": "Zero-trust access-control models require granular service identity and authorization policy rather than inheriting broad trust across distributed services.",
          "source": "NIST SP 800-207A",
          "url": "https://csrc.nist.gov/pubs/sp/800/207/a/final"
        }
      ]
    },
