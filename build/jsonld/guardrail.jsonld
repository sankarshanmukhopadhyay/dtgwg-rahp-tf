    {
      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/GR-04",
      "@type": "Guardrail",
      "name": "Reciprocal VRC Requirement",
      "category": "Technology / Governance",
      "requirement": "No VMC shall be issued to a trust anchor or member without a verified reciprocal VRC exchange. The VTA PEP must reject VMC issuance where only a unilateral VRC exists.",
      "applies_to_phase": "Phase 2–4",
      "owner": "VTA PEP",
      "risksAddressed": [
