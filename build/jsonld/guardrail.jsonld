    {
      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/GR-20",
      "@type": "Guardrail",
      "name": "Age Assurance Architecture Readiness",
      "category": "Safeguarding / Technology",
      "requirement": "Before any VTC member may operate as an age-restricted relying party under the Online Safety Act 2023 or equivalent legislation, the governing body must verify that: (a) the ZKP implementation used for over-18 proofs has been independently audited (AT-06 extended to age context); (b) the IDVP trust registry entries used for age verification include an age-verification scope claim; (c) the IDVP's cross-jurisdiction standing can be verified in near-real-time; and (d) a child safety incident response protocol has been published. Non-compliance with this guardrail means the VTC cannot support OSA 2023-regulated use cases.",
      "applies_to_phase": "Phase 4 (pre-condition for age-restricted relying party operations)",
      "owner": "Governing Body / IDVP",
      "risksAddressed": [
        "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/RK-CY01",
        "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/RK-EX04",
