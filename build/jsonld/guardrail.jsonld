    {
      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/GR-18",
      "@type": "Guardrail",
      "name": "R-DID Migration Phase Gate",
      "category": "Technology / Governance",
      "requirement": "Before Phase 4 opens (or before the VTC exceeds a governance-defined membership threshold, whichever comes first), the VTC MUST complete migration from M-DID-based to R-DID-based VRC edges, or formally risk-accept the residual linkability exposure with a documented rationale and review date. The migration trigger MUST be recorded in the trust registry. New VRCs issued after the trigger MUST use R-DIDs. This guardrail converts the spec's §5.2 privacy RECOMMENDATION ('migration recommended post-bootstrapping') into a binding phase gate, closing the residual window identified in RK-SC04. **Source:** DTG Credential Spec v0.3 §5.2 Privacy Considerations.",
      "applies_to_phase": "Pre-Phase 4",
      "owner": "VTA PEP / Governing Body",
      "risksAddressed": [
        "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/RK-HX01",
        "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/RK-ID05",
        "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/RK-SC04"
      ],
      "controls": [
        "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/CT-50"
      ],
      "assuranceTests": [
        "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/AT-18"
      ],
      "standardsStatus": "unassigned",
      "provenance": {
        "source": "workbook:RiskRegister_v5.xlsx",
        "imported": "2026-08-05"
      }
    },
    {
      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/GR-19",
      "@type": "Guardrail",
      "name": "Supported Decision-Making and Legal Delegation Pathway",
      "category": "Human Experience / Legal",
      "requirement": "Before a VTC may admit any participant who requires supported or substituted decision-making, or any participant for whom a registered legal authority (LPA, court deputyship, or equivalent) is in place, the VTC must: (a) have defined a supported consent pathway in its admission policy; (b) have a credential mechanism capable of representing co-signed consent and LPA delegation distinctly from substituted impersonation; and (c) have registered the legal delegation in the trust registry with a scope-limited delegation credential. Absence of this pathway is a block on admission for in-scope participants.",
      "applies_to_phase": "Phase 3–4 (pre-condition for admission of in-scope participants)",
      "owner": "Governing Body / VTC Initiator",
      "risksAddressed": [
        "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/RK-HX04",
        "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/RK-HX05",
