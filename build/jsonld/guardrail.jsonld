    {
      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/GR-21",
      "@type": "Guardrail",
      "name": "Organisational Identity Governance Mapping",
      "category": "Governance / Organisational",
      "requirement": "Before a regulated organisation may be admitted as a VTC member using a C-DID or Organisational Member Credential (OMC), the governing body must: (a) verify the organisation's legal identifier and regulatory standing; (b) document the mapping between the organisation's internal governance framework and the VTC governance conformance class (CT-56); (c) identify the individual officers responsible for credential operations and their personal DIDs; and (d) confirm that the organisation's data residency requirements are compatible with the VTC trust registry's architecture. Admission without this mapping is blocked.",
      "applies_to_phase": "Phase 1–4 (pre-condition for organisational member admission)",
      "owner": "Governing Body",
      "risksAddressed": [
        "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/RK-EX05"
      ],
      "controls": [
