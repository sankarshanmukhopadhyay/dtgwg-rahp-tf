    {
      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/GR-05",
      "@type": "Guardrail",
      "name": "IDVP Registry Standing",
      "category": "Technology / Governance",
      "requirement": "IDVCs are only valid for VTC admission if issued by an IDVP whose DID is listed in the VTC trust registry with the role of identity verification provider at the time of presentation.",
      "applies_to_phase": "Phase 4",
      "owner": "VTA PEP / Governing Body",
      "risksAddressed": [
