    {
      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/GR-01",
      "@type": "Guardrail",
      "name": "Genesis Policy Documentation",
      "category": "Governance",
      "requirement": "All Phase 1 bootstrapping policies must be version-controlled, publicly readable, and committed to an auditable record before the initiator issues any Phase 2 invitations. Hard-coded policy changes require documented governance approval.",
      "applies_to_phase": "Phase 1 (all subsequent phases)",
      "owner": "Initiator / Governing Body",
