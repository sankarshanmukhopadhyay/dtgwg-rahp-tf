    {
      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/GR-16",
      "@type": "Guardrail",
      "name": "Formal Threat Model Publication",
      "category": "Governance",
      "requirement": "A formal VTC threat model covering Sybil attacks, state coercion, anchor collusion, AI-mediated attacks, registry manipulation, and CIB must be published and reviewed before Phase 4 opens and at least annually thereafter.",
