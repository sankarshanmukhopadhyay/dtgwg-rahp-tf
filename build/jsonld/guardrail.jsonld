    {
      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/GR-02",
      "@type": "Guardrail",
      "name": "Time-Bounded Initiator Authority",
      "category": "Governance",
      "requirement": "Initiator authority must be explicitly time-bounded or role-transitioned under documented governance rules. The VTA PEP must enforce the initiator count limit and refuse Phase 2 actions after authority expiry.",
      "applies_to_phase": "Phase 1–2",
      "owner": "VTA PEP / Governing Body",
      "risksAddressed": [
