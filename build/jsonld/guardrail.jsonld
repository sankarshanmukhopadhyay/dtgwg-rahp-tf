    {
      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/GR-17",
      "@type": "Guardrail",
      "name": "Open Issues Risk Acceptance",
      "category": "Governance",
      "requirement": "The four open issues from the VTC Bootstrapping Draft — uniqueness, trust task protocols, expiration/revocation, DID document storage — must each be either mitigated or formally risk-accepted by the governing body before Phase 4 opens.",
