      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/GR-12",
      "@type": "Guardrail",
      "name": "Agent Delegation Scope Constraint",
      "category": "Technology / Governance",
      "requirement": "AI agents operating on behalf of VTC members must hold cryptographically scoped delegation credentials with explicit capability constraints. Operator revocation of a VMC must propagate to agent credential invalidation within an agreed latency SLA.",
