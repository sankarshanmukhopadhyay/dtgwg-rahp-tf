    {
      "@id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/id/GR-03",
      "@type": "Guardrail",
      "name": "Trust Anchor Diversity Policy",
      "category": "Governance / Human Experience",
      "requirement": "A minimum diversity standard for trust anchors must be defined and documented before Phase 2 seeding. The VTA must enforce the anchor count limit. Homogeneous anchor clusters constitute a policy violation.",
      "applies_to_phase": "Phase 2",
      "owner": "Governing Body",
      "risksAddressed": [
