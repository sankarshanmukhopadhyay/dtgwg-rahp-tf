        "acceptance_permitted": false,
        "required_action": "guardrail_required"
      },
      "risk_acceptance_bands": [
        {
          "match": "High severity × High likelihood",
          "authority": "full_working_group",
          "review_period": "P6M",
          "evidence_threshold": "documented rationale plus current assurance evidence"
        },
        {
          "match": "High severity (score 3–6)",
          "authority": "task_force_co_chairs",
          "review_period": "P12M",
          "evidence_threshold": "documented rationale plus current assurance evidence"
        },
        {
          "match": "Medium or Low severity",
          "authority": "task_force",
          "review_period": "P12M",
          "evidence_threshold": "documented rationale and proportionate evidence"
        }
      ],
      "required_acceptance_fields": [
        "authority",
        "decided_by",
        "decision_date",
        "rationale",
        "residual_risk",
        "review_date",
        "evidence"
